{
  "name": "riskmulate",
  "version": "0.1.0",
  "private": true,
  "description": "Immersive single-player factory risk training",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:offline --workspace factory-shift-prototype",
    "build": "npm run build:offline --workspace factory-shift-prototype",
    "format": "prettier --write \"apps/studio/**/*.{js,json,ts,tsx,css,html}\" \"*.json\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"apps/studio/**/*.{js,json,ts,tsx,css,html}\" \"*.json\" \".github/**/*.{yml,yaml}\"",
    "lint": "npm run lint --workspace @riskmulator/studio && cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "test": "npm run build && node --test apps/factory-shift/tests/offline-build.test.mjs && node --test --test-name-pattern='physical F-201|PC keyboard|simplified HUD|character hands' apps/factory-shift/tests/rendered-html.test.mjs",
    "tauri": "npm run tauri --workspace @riskmulator/studio",
    "browserless:smoke": "node scripts/browserless-smoke.mjs",
    "format:rust": "cargo fmt --all",
    "format:rust:check": "cargo fmt --all --check",
    "preview": "npm run preview:offline --workspace factory-shift-prototype",
    "test:legacy": "npm run test --workspace @riskmulator/studio && cargo test --workspace --all-targets --all-features"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "puppeteer-core": "25.3.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.4.2"
}
