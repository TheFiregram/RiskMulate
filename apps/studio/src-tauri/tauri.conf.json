{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RiskMulator Studio",
  "version": "0.1.0",
  "identifier": "studio.riskmulator.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:studio",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RiskMulator Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
